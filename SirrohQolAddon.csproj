<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>SirrohQolAddon</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ReferenceDir Condition="'$(ReferenceDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim/valheim_Data/Managed</ReferenceDir>
    <BepDir Condition="'$(BepDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim/BepInEx/core</BepDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
