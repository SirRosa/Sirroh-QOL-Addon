    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ReferenceDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ReferenceDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
